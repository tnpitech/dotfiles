{
  "exclusive": true,
  "reload_style_on_change": true,
  "layer": "top",
  "modules-left": [
    "umbriel/workspaces",
    "umbriel/window"
  ],
  "modules-center": [],
  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "clock"
  ],
  "umbriel/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-name": true
  },
  "umbriel/window": {
    "format": "{app_id}",
    "icon": true,
    "icon-size": 18,
    "separate-outputs": true
  },
  "clock": {
    "format": "󰨲 {:%H:%M %a %d.%m}",
    "tooltip-format": "{:%H.%M %A %d/%m/%Y}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "  muted",
    "format-icons": {
      "default": ""
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "interface": "enp2s0",
    "format": " {ifname}",
    "format-wifi": "󰤢 {essid}",
    "format-disconnected": "󰖪  no network"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋{capacity}%",
    "format-plugged": "󱐋{capacity}%",
    "format-icons": {
      "default": [
        "",
        "",
        "",
        "",
        ""
      ],
      "charging": [
        "󱐋",
        "󱐋",
        "󱐋",
        "󱐋",
        "󱐋"
      ]
    }
  }
}
