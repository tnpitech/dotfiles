{
  "exclusive": true,
  "reload_style_on_change": true,
  "layer": "top",
  "modules-left": ["ext/workspaces"],
  "modules-center": [],
  "modules-right": ["network", "pulseaudio", "clock"],
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true
  },
  "clock": {
    "format": "󰨲 {:%H:%M %a %d.%m}",
    "tooltip-format": "{:%H.%M %A %d/%m/%Y}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ""
    },
    "on-click": "pavucontrol"
  },
  "network": {
    "interface": "enp2s0",
    "format": " {ifname}",
    "format-wifi": "󰤢 {essid}",
    "format-disconnected": "󰖪 no network"
  }
}
