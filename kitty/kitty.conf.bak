# vim:fileencoding=utf-8:foldmethod=marker

font_size 16.0
background_opacity 0.95

# BEGIN_KITTY_FONTS
font_family      family="Iosevka Nerd Font"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS


# BEGIN_KITTY_THEME
# duckbones
include current-theme.conf
# END_KITTY_THEME
